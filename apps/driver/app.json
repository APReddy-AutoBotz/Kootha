      "image": "./assets/kootha-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff8ec"
    },
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.kootha.driver",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "productName": "Kootha"
    }
  }
}
