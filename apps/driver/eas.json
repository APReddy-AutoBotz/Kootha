{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "internal": {
      "distribution": "internal",
      "channel": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "preview"
      }
    },
    "production": {
      "distribution": "internal",
      "channel": "production",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "production"
      }
    }
  }
}
