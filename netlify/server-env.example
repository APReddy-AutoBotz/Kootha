# Netlify server environment placeholders. Configure these in Netlify, never in client env files.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
ENQUIRY_RATE_LIMIT_SALT=replace-with-random-server-only-salt
ENQUIRY_INTAKE_ENABLED=false
RETENTION_DELETION_ENABLED=false
# M21 server-only telemetry ingestion. Thresholds remain database-owned and provisional.
TELEMETRY_INGEST_ENABLED=false
TELEMETRY_CREDENTIAL_PEPPER=replace-with-random-server-only-credential-pepper
TELEMETRY_RATE_LIMIT_KEY=replace-with-random-server-only-rate-limit-key

# M22 server-only deterministic rule engine and scheduled health sweep. Disabled by default.
M22_RULE_ENGINE_ENABLED=false
M22_HEALTH_SWEEP_BATCH_SIZE=250
M22_RETENTION_BATCH_SIZE=250
