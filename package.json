{
    "name":  "kootha-prachar",
    "version":  "0.0.0",
    "private":  true,
    "description":  "Kootha field advertisement planning and proof platform.",
    "type":  "module",
    "packageManager":  "pnpm@9.15.4",
    "scripts":  {
                    "dev:web":  "pnpm --filter @kootha/web dev",
                    "dev:driver":  "pnpm --filter @kootha/driver start --android",
                    "lint":  "node scripts/lint.mjs",
                    "typecheck":  "pnpm --recursive --if-present run typecheck",
                    "test":  "vitest run",
                    "build":  "pnpm --recursive --if-present run build",
                    "check:pilot-env":  "node scripts/check-pilot-env.mjs",
                    "check:pilot-readiness":  "node scripts/check-pilot-readiness.mjs",
                    "security:scan":  "node scripts/security-scan.mjs",
                    "migrations:check":  "node scripts/check-migrations.mjs",
                    "evidence:m21-load":  "vitest run tests/m21-load-evidence.test.ts --reporter=verbose",
                    "benchmark:m21-auth":  "vitest run tests/m21-auth-cost-benchmark.test.ts --reporter=verbose",
                    "test:m21-scope":  "vitest run tests/m21-scope-guardrails.test.ts --reporter=verbose"
                },
    "devDependencies":  {
                            "@types/node":  "^20.17.19",
                            "@vitejs/plugin-react":  "^4.3.4",
                            "typescript":  "^5.7.3",
                            "vite":  "^6.1.0",
                            "vitest":  "^3.0.5"
                        }
}
